# Postgres (Neon). Ej: postgres://user:pass@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Sin esta variable la app muestra datos de ejemplo y no guarda nada.
DATABASE_URL=

# Login: contraseña única para entrar. Si queda vacía, la app NO pide login (solo para uso local).
APP_PASSWORD=
# Opcional: secreto extra para firmar la cookie de sesión. Cambiarlo cierra todas las sesiones.
AUTH_SECRET=

# Lectura de boletas y recibos con Claude (OPCIONAL, es pago).
# Sin key, los PDFs digitales se leen gratis con su texto y las fotos se completan a mano.
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5-5

# Cotizaciones del dólar (API pública, sin key). Se cachea en el server y se guarda en la base.
DOLLAR_API_URL=https://dolarapi.com/v1/dolares
DOLLAR_CACHE_MINUTES=20

# Avisos push de vencimientos. Generá las claves con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-mail@ejemplo.com
# Protege el cron diario (/api/cron/due-alerts). Vercel lo manda solo si existe esta variable.
CRON_SECRET=
